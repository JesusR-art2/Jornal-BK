# Docker Compose (development)
POSTGRES_DB=jornalDb
POSTGRES_USER=jornalAdmin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional: create the first admin on startup
# ADMIN_EMAIL=admin@jornal.com
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Administrator
# ADMIN_COUNTRY=CO
# ADMIN_LOCALE=es-CO

# Production profile examples (not used by docker compose)
# DB_URL=jdbc:postgresql://host:5432/jornalDb
# DB_USER=jornalAdmin
# DB_PASSWORD=change-me
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# JWT_SECRET=change-me-minimum-32-bytes
# JWT_ISSUER=jornal-prod
