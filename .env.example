# Docker Compose (development)
POSTGRES_DB=jornalDb
POSTGRES_USER=jornalAdmin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Country served by this instance (CO, BR, US, FR or JP). Default: CO
# APP_REGION=CO

# Optional: create the first admin of the region on startup
# ADMIN_EMAIL=admin@jornal.com
# ADMIN_PASSWORD=change-me
# ADMIN_GIVEN_NAME=Admin
# ADMIN_FAMILY_NAME=Jornal
# ADMIN_LOCALE=es-CO

# Production profile examples (not used by docker compose)
# DB_URL=jdbc:postgresql://host:5432/jornalDb
# DB_USER=jornalAdmin
# DB_PASSWORD=change-me
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# JWT_SECRET=change-me-minimum-32-bytes
# JWT_ISSUER=jornal-prod
