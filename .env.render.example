# Variables de entorno de ejemplo para desplegar en Render (valores FICTICIOS: no son credenciales reales).
# No suba un archivo con valores reales; en Render se cargan en "Environment" de cada servicio.
# Para desarrollo local con docker compose use .env.example. Detalle por servicio: docs/DESPLIEGUE-RENDER.md

# ---------------------------------------------------------------- comunes a core-co, payments y notifications
SPRING_PROFILES_ACTIVE=prod
# PostgreSQL de Render (conexión interna). La misma base para todos; cada servicio usa su propio esquema.
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-ejemplo-a:5432/jornal_ejemplo
SPRING_DATASOURCE_USERNAME=usuario_ejemplo
SPRING_DATASOURCE_PASSWORD=clave_ejemplo
# Esquema propio de cada servicio: core_co | payments | notifications
DB_SCHEMA=core_co
# CloudAMQP (RabbitMQ gestionado, plan gratuito Little Lemur)
SPRING_RABBITMQ_ADDRESSES=amqps://usuario_ejemplo:clave_ejemplo@ejemplo.rmq.cloudamqp.com/usuario_ejemplo
# Solo una región y solo las colas de los servicios desplegados
MESSAGING_REGIONS=co
MESSAGING_CONSUMERS=core,payments,notifications
# JWT compartido entre el core y los subsistemas (mínimo 32 caracteres) y su emisor
JWT_SECRET=cambie-este-secreto-de-ejemplo-de-32-caracteres
JWT_ISSUER=jornal-render
# Token para la consulta interna de contactos (notifications -> core)
INTERNAL_TOKEN=cambie-este-token-interno-de-ejemplo
# Detrás del proxy HTTPS de Render
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ---------------------------------------------------------------- solo core-co
APP_REGION=CO
# Key Value de Render (compatible con Redis), conexión interna
SPRING_DATA_REDIS_URL=redis://red-ejemplo:6379
# URL del frontend (separadas por coma; admite patrones como https://*.onrender.com)
CORS_ALLOWED_ORIGINS=https://jornal-ejemplo.onrender.com
# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@ejemplo.test
ADMIN_PASSWORD=clave-admin-de-ejemplo
# Opcional: traducción automática (vacío = desactivada) y servicios que vigila la consola de administración
TRANSLATION_URL=
CONSOLE_SERVICES=

# ---------------------------------------------------------------- solo notifications
CORE_URL_TEMPLATE=https://jornal-core-co-ejemplo.onrender.com
# Opcional: SMTP real para correos (sin esto el aviso por correo queda FAILED y lo demás funciona)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=notificaciones@ejemplo.test
